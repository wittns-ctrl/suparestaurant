# Copy to .env.production for Docker Compose, or add these values to your
# hosting provider's secret manager. Never commit actual credentials.
API_PORT=3000
MONGO_URI=
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=2
JWT_SECRET=
JWT_REFRESH=
FRONTEND_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example
REDIS_URL=rediss://default:token@your-upstash-host:6379
REDIS_KEY_PREFIX=supameal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=supameal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
PAYPAL_CURRENCY=USD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SENDLIBERTY_API_KEY=
SENDLIBERTY_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_EMAIL=
SUPPORT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api.example/auth/google/callback
TRUST_PROXY=1
