# Copy to .env next to docker-compose.yml and fill in the required values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── REQUIRED ──────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# ── URLs (defaults match docker-compose) ──────────────────────────────────
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SAME_SITE=lax
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
REDIS_URL=
REDIS_KEY_PREFIX=supameal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=supameal
VITE_API_URL=http://localhost:3000
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_TWITTER_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_WHATSAPP_URL=
# Optional: WhatsApp phone with country code, e.g. 250736752015. Used if the profile URL above is blank.
VITE_WHATSAPP_PHONE=
VITE_SUPPORT_EMAIL=mugishawitness15@gmail.com
VITE_CAREERS_EMAIL=careers@supameal.com

# ── PayPal Checkout API credentials from a PayPal Developer Dashboard REST app
#    Use sandbox credentials for development; do not expose the secret to the frontend.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

# ── Email (OTP + password reset won't send without this) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
SUPPORT_EMAIL=mugishawitness15@gmail.com
RESEND_API_KEY=

# ── Google OAuth (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Misc ──────────────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
SEED_DEMO_DATA=false

# Reverse proxy trust for correct client-IP rate limiting
TRUST_PROXY=loopback
